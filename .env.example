# Database Credentials for Local Docker PostgreSQL
POSTGRES_USER=anaya
POSTGRES_PASSWORD=generate_a_random_password_here
POSTGRES_DB=anaya

# Database Connection URL (used by FastAPI backend)
# When running inside Docker Compose, host is 'db'. For external: localhost or remote host.
DATABASE_URL=postgresql+asyncpg://anaya:generate_a_random_password_here@db:5432/anaya

# Shared Internal Secret for Telegram Generator Bot & Admin Endpoints
INTERNAL_API_SECRET=generate_a_32_byte_hex_secret_here

# Fast Streaming & Storage Resolution:
# false: Returns JioSaavn direct stream URL immediately (< 0.3s latency)
# true:  Uploads track to Yukisbox persistent storage before returning (fallback to direct URL on failure)
STORAGE_UPLOAD_ENABLED=false

# Yukisbox Storage Settings
YUKISBOX_BASE_URL=https://yukiapi.site
YUKISBOX_TIMEOUT=60

# Rust Media Engine (Leave empty if running lightweight Python-standalone mode)
RUST_MEDIA_ENGINE_URL=

# Service Limits & Configuration
TEMP_DIR=./temp
LIFETIME_QUOTA=200
PORT=8000
WEB_CONCURRENCY=2
