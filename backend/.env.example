# Environment variables for Kiwi Music API Backend

# Host and Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL Connection String (Neon, Supabase, or Render PostgreSQL)
# For asyncpg, use 'postgresql+asyncpg://...'
DATABASE_URL=postgresql+asyncpg://username:password@host/database?ssl=require

# Shared Internal Management Secret (MUST match BACKEND_INTERNAL_SECRET on tg-generator-bot)
INTERNAL_API_SECRET=your_super_secret_internal_token_here

# Application Secret Key
SECRET_KEY=generate_a_random_32_byte_hex_string_here

# Yukysbox Storage API Base URL
YUKISBOX_BASE_URL=https://yukiapi.site
YUKISBOX_TIMEOUT=300

# JioSaavn API Provider URL
JIOSAAVN_API_URL=https://saavn.dev

# Rust Media Engine (Axum streaming service)
RUST_MEDIA_PORT=8088
RUST_MEDIA_ENGINE_URL=http://127.0.0.1:8088

# yt-dlp Extractor Configuration
YTDLP_ENABLED=true
YTDLP_TIMEOUT=120

# Concurrency & Download limits
MAX_UPLOAD_CONCURRENCY=3
MAX_DOWNLOAD_SIZE_MB=100
